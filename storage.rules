rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{folder}/{file} {
      // 자료실 파일과 배너 이미지는 공개
      allow read: if folder in ['resources', 'banners'];
      // 올리기는 로그인한 계정만, 한 번에 20MB 까지
      allow write: if request.auth != null
        && folder in ['resources', 'banners']
        && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
