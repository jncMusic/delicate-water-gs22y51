# ── Firebase 설정 ─────────────────────────────────────────────
# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정 및 구성 에서 복사해 넣으세요.
# 이 값들이 비어 있으면 홈페이지는 데모(브라우저 저장) 모드로 동작합니다.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# ── 데모 모드 관리자 통과 코드 ────────────────────────────────
# Firebase 연결 전 화면을 둘러볼 때만 쓰입니다. 실제 보안 수단이 아닙니다.
REACT_APP_DEMO_ADMIN_CODE=admin
